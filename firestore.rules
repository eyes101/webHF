rules_version = '2';

// All reads/writes go through the Cloud Function (Admin SDK), which bypasses
// these rules entirely. The frontend never talks to Firestore directly — it
// only talks to Firebase Auth (for sign-in) and our own API (for data). So
// we deny all direct client access here as defense-in-depth: even if a bug
// somewhere tried to read/write Firestore straight from the browser, this
// blocks it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
