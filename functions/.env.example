# functions/.env.example
# ==============================================================================
# Halfcon Backend Cloud Function Environment Configuration
# ==============================================================================

# 1. Payment Gateway Configuration
# Options: 'paystack' (for Live/Test Paystack Gateway) or 'manual' (for Sandbox Simulator)
PAYMENT_PROVIDER=paystack

# Paystack API Keys (Get these from https://dashboard.paystack.com/#/settings/developer)
# Use 'sk_test_...' for testing (cards 4084084084084081) or 'sk_live_...' for real Naira billing
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Application URLs
FRONTEND_URL=https://www.halfcon.site
CORS_ORIGIN=https://www.halfcon.site,https://halfcon.site,http://localhost:5173

# 3. Firebase Project Configuration
FIREBASE_PROJECT_ID=halfcon-project
